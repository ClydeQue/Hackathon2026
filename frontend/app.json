{
  "expo": {
    "name": "SlowFashion",
    "slug": "slowfashion",
    "scheme": "slowfashion",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFE66D"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.slowfashion.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.slowfashion.app"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow SlowFashion to use the camera to scan your clothes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow SlowFashion to access your photos so you can add clothes to your catalogue."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow SlowFashion to use your location to set the pickup point for donations."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
